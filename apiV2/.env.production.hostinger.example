# Requisito Hostinger: PHP 8.4+ no subdomínio apiv2.
#
# HTTP (site / API): .htaccess em apiV2/ e apiV2/public/ usa SetHandler application/x-lsphp84
# CLI/cron (SSH):   /opt/alt/php84/usr/bin/php  (NÃO use "php" genérico — costuma ser 8.3)
#                   Ex.: /opt/alt/php84/usr/bin/php artisan config:clear
# Deploy: NÃO suba bootstrap/cache/packages.php gerado com dev deps (Pail, etc.).
#         Apague bootstrap/cache/*.php no servidor ou rode config:clear após upload.
#
# Copie para .env na pasta apiV2/ do servidor (mesmo nível de artisan).
# Valores de DB/JWT/MP/Resend: copie do .env da API Slim em produção.
# APP_KEY: gere localmente com: docker compose run --rm php-v2 php artisan key:generate --show

APP_NAME=AppCheckin
APP_ENV=production
APP_KEY=base64:COLE_AQUI_APP_KEY_GERADA_LOCALMENTE
APP_DEBUG=false
APP_URL=https://apiv2.appcheckin.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Laravel usa DB_DATABASE / DB_USERNAME / DB_PASSWORD (não DB_NAME / DB_USER / DB_PASS)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u304177849_api
DB_USERNAME=u304177849_api
DB_PASSWORD="COLE_SENHA_DO_SLIM"

# OBRIGATÓRIO: copie o JWT_SECRET EXATO do .env da Slim (public_html/api/.env).
# Login com várias academias só gera token em select-tenant-public — secret errado = erro 500.
JWT_SECRET=COLE_JWT_SECRET_REAL_DA_SLIM
JWT_EXPIRATION=864000

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Email (recuperação de senha)
MAIL_MAILER=resend
RESEND_API_KEY=COLE_RESEND_API_KEY
MAIL_FROM_ADDRESS=mail@appcheckin.com.br
MAIL_FROM_NAME="App Check-in"

# Mercado Pago
MP_ENVIRONMENT=production
MP_ACCESS_TOKEN_TEST=COLE_SE_USAR_SANDBOX
MP_PUBLIC_KEY_TEST=COLE_SE_USAR_SANDBOX
MP_ACCESS_TOKEN_PROD=COLE_MP_ACCESS_TOKEN_PROD
MP_PUBLIC_KEY_PROD=COLE_MP_PUBLIC_KEY_PROD

# Fotos de perfil (compartilhadas com a Slim). Com symlink (scripts/hostinger-link-uploads.sh) pode omitir.
# UPLOADS_FOTOS_DIR=/home/u304177849/domains/appcheckin.com.br/public_html/api/public/uploads/fotos
# UPLOADS_LEGACY_DIR=/home/u304177849/domains/appcheckin.com.br/public_html/api/public/uploads/fotos
