{
  "name": "site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "web": "vite",
    "build": "node scripts/fetch-planos.js && vite build",
    "web:build": "vite build",
    "web:pack": "bash scripts/pack-dist.sh",
    "preweb:build": "node scripts/increment-version.js patch && node scripts/fetch-planos.js",
    "bump:patch": "node scripts/increment-version.js patch",
    "bump:minor": "node scripts/increment-version.js minor",
    "bump:major": "node scripts/increment-version.js major",
    "lint": "oxlint",
    "preview": "vite preview",
    "planos": "node scripts/fetch-planos.js"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "vite": "^8.3.4"
  }
}
