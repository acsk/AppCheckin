# API Configuration
# Para web em produção, use a URL do backend
EXPO_PUBLIC_API_URL=http://localhost:8080

# Ou use estas variáveis conforme seu build tool
REACT_APP_API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080

# Environment
NODE_ENV=development

# Backend Server
BACKEND_URL=http://localhost:8080

# Token para publicar versão no build (mesmo valor da apiV2)
APP_VERSION_UPDATE_TOKEN=
APP_VERSION_API_URLS=https://apiv2.appcheckin.com.br/v2
